# =============================================================================
#  LinkedIn Outreach CRM - all configuration
#
#  Copy to .env and edit:      copy .env.example .env
#
#  This one file configures BOTH the outreach orchestrator (OUTREACH_*) and the
#  LinkedIn MCP server (LINKEDIN_MCP_*). Real environment variables override
#  whatever is written here, which is how GitHub Actions injects settings.
#
#  NO SECRETS BELONG IN THIS FILE. Your LinkedIn session lives in the MCP
#  server's own Chromium profile. .env is gitignored; .env.example is not.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. WHO TO SEARCH FOR
# -----------------------------------------------------------------------------
# A name for this campaign. Appears in the Excel log. Letters/numbers/._- only.
OUTREACH_CAMPAIGN_ID=crypto-partnerships

# Main search keywords. Supports LinkedIn Boolean syntax: quotes, AND, OR, NOT.
OUTREACH_SEARCH_QUERY=business development partnerships crypto exchange

# LinkedIn's visible "Title" keyword box. Narrows hard - leave blank to widen.
OUTREACH_SEARCH_TITLE=

# Extra role words appended to the query rather than used as a facet.
OUTREACH_SEARCH_TITLE_KEYWORDS=

# Visible "Company" and "School" keyword boxes.
OUTREACH_SEARCH_COMPANY=
OUTREACH_SEARCH_SCHOOL=

# Only match people visibly hiring. true/false.
OUTREACH_SEARCH_ACTIVELY_HIRING=false

# Network distance to target. Comma-separated.
#   first          = already connected (no invite needed, goes straight to DM)
#   second         = friend-of-a-friend, the most responsive group
#   third_or_more  = everyone else
OUTREACH_CONNECTION_DEGREES=second,third_or_more

# ---- Facet filters. Comma-separated, max 10 each. --------------------------
# WARNING: these narrow aggressively. On some accounts a location filter
# returns ZERO results even when the plain query returns plenty. If discovery
# finds nothing, empty these FIRST. Leave blank unless you need them.
OUTREACH_SEARCH_LOCATIONS=
OUTREACH_SEARCH_INDUSTRIES=
OUTREACH_SEARCH_CURRENT_COMPANIES=
OUTREACH_SEARCH_PAST_COMPANIES=
OUTREACH_SEARCH_SCHOOLS=


# -----------------------------------------------------------------------------
#  2. WHAT TO SAY
#
#  Placeholders: {first_name} {name} {headline} {company} {location}
#  Unknown placeholders become empty strings; they never crash a run.
#  Use \n for line breaks - .env values must stay on one line.
# -----------------------------------------------------------------------------

# Sent WITH the connection request. LinkedIn's hard limit is 200 characters;
# anything longer is truncated with an ellipsis rather than rejected.
OUTREACH_INVITE_NOTE=Hi {first_name}, I work on crypto x finance partnerships at Mudrex. Always keen to compare notes with others building in this space. Would be great to connect.

# Sent ONLY after they accept. Never sent as a cold message.
OUTREACH_DM_BODY=Thanks for connecting, {first_name}!\n\nI look after partnerships at Mudrex - we work across crypto and traditional finance rails, so B2B integrations are a big part of what I do.\n\nCurious what your team is focused on at the moment, and whether there is a sensible overlap worth exploring.\n\nWould a short call be useful?


# -----------------------------------------------------------------------------
#  3. SAFETY LIMITS
#
#  Two independent layers. Per-run caps bound a single execution; daily caps
#  bound everything sent today across every run. Start low. LinkedIn restricts
#  accounts that send aggressively, and that is not reversible on your side.
# -----------------------------------------------------------------------------
OUTREACH_MAX_DISCOVER_PER_RUN=25
OUTREACH_MAX_INVITES_PER_RUN=5
OUTREACH_MAX_DMS_PER_RUN=5

OUTREACH_DAILY_INVITE_CAP=20
OUTREACH_DAILY_DM_CAP=20

# DRY RUN. true = log intended actions and send NOTHING. Keep true until the
# console output looks right, then set false (or pass --live).
OUTREACH_DRY_RUN=true


# -----------------------------------------------------------------------------
#  3b. THROTTLE  (how long to wait between sends)
#
#  This is the single biggest lever on account safety. LinkedIn tolerates a
#  human pace; what looks automated is a burst of writes seconds apart.
#  With the defaults below, 5 invites take roughly 4-5 minutes, not 20 seconds.
#
#  Lower these only if you understand the risk. Higher is always safer.
# -----------------------------------------------------------------------------
# Seconds to wait after each connection request.
OUTREACH_INVITE_DELAY_SECONDS=45

# Seconds to wait after each message.
OUTREACH_DM_DELAY_SECONDS=60

# Random extra 0-N seconds added to every wait above, so sends are not evenly
# spaced. Set 0 for fixed intervals (not recommended).
OUTREACH_ACTION_JITTER_SECONDS=20


# -----------------------------------------------------------------------------
#  4. AUTOMATIC LOOP
#
#  Used by start.ps1 and `linkedin-outreach run-loop`.
# -----------------------------------------------------------------------------
# Minutes between runs.
OUTREACH_LOOP_MINUTES=30

# Random extra 0-N minutes added to each wait, so runs are not clockwork.
OUTREACH_LOOP_JITTER_MINUTES=5

# Stop after N iterations. 0 = run forever until you press Ctrl+C.
OUTREACH_MAX_LOOPS=0


# -----------------------------------------------------------------------------
#  5. POLLING BREADTH
#
#  Each unit below costs roughly one page load, so these control run duration.
# -----------------------------------------------------------------------------
# Pages of "recently added connections" scanned to detect who accepted.
OUTREACH_ACCEPT_SCAN_PAGES=3

# Fallback: invited profiles re-checked one by one when the scan above does not
# confirm them. On some accounts the connections page returns almost nothing,
# and without this accepts would never be detected. 0 disables it.
OUTREACH_ACCEPT_VERIFY_PER_RUN=5

# Conversations polled for replies each run.
OUTREACH_MAX_REPLY_CHECKS_PER_RUN=25

# Open every discovered profile for full company detail. Roughly 10x slower.
OUTREACH_ENRICH_PROFILES=false


# -----------------------------------------------------------------------------
#  6. FILES
# -----------------------------------------------------------------------------
OUTREACH_EXCEL_PATH=outreach_log.xlsx
OUTREACH_DB_PATH=outreach_state.db

# OPTIONAL multi-campaign mode. Point this at a YAML file to run several
# campaigns at once; it then REPLACES sections 1 and 2 above.
# See campaigns.example.yaml. Leave blank to use the single campaign from .env.
OUTREACH_CAMPAIGNS_FILE=


# -----------------------------------------------------------------------------
#  7. BROWSER AND MCP SERVER
# -----------------------------------------------------------------------------
# Headless is faster. Set false to watch the browser while debugging.
OUTREACH_BROWSER_HEADLESS=true

# Seconds before a single LinkedIn operation is abandoned.
OUTREACH_MCP_TIMEOUT_SECONDS=300

# Seconds between page navigations. Lowering this increases restriction risk.
LINKEDIN_MCP_MINIMUM_NAVIGATION_INTERVAL_SECONDS=2

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LINKEDIN_MCP_LOG_LEVEL=INFO

# Chromium is installed automatically on first use.
LINKEDIN_MCP_BROWSER_AUTO_INSTALL=true
LINKEDIN_MCP_AUTO_LOGIN_ON_START=true
